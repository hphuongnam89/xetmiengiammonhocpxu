# Production only. Never use these placeholders as credentials.
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
ALLOWED_HOSTS=your-domain.example
DB_ENGINE=django.db.backends.postgresql
DB_NAME=course_exemption
DB_USER=course_exemption_app
DB_PASSWORD=replace-with-a-secret
DB_HOST=postgres.internal
DB_PORT=5432
DB_SSLMODE=require
REDIS_URL=rediss://user:password@redis.internal:6379/1
# Use an installed private object-storage backend, not FileSystemStorage.
MEDIA_STORAGE_BACKEND=replace-with-your-private-storage-backend
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# Set true only when a trusted TLS-terminating proxy overwrites X-Forwarded-Proto.
SECURE_BEHIND_PROXY=false
CSRF_TRUSTED_ORIGINS=https://your-domain.example
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=gemma4:e4b-it-qat
